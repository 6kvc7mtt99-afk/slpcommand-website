BACKEND_URL=https://english-learning-backend-b5uw.onrender.com
# Optional: Search Console verification token (meta tag only; sets no cookies).
# GOOGLE_SITE_VERIFICATION=

# ── Q4 — Web Billing offer (server-only; see docs/SLP-COMMAND-Q4-WEB-BILLING.md) ──
#
# None of these unlock a checkout by themselves. The kill switch is
# `web_billing_enabled` in the backend's `feature_flags` table (NOT an env
# var, so it can be flipped without a redeploy) — see lib/api/featureFlags.ts.
# Even with the flag on, /api/billing/checkout fails closed (404) unless
# BOTH WEB_BILLING_PRODUCT_ID and WEB_BILLING_PURCHASE_URL are set — verified
# by tests/unit/checkoutRoute.test.ts.
#
# Read only in lib/plan/offer.ts. Never sent to the browser as a NEXT_PUBLIC_
# value — the offer's safe shape (product id, plan name, optional display
# price) is resolved server-side and only that shape reaches the client; the
# purchase URL itself never does (app/api/billing/checkout/route.ts builds it
# per-request from the session and returns only the finished link).

# REQUIRED (with WEB_BILLING_PURCHASE_URL) for a checkout to be buildable at all.
# SERVER-ONLY. Not a secret — RevenueCat's own product identifier.
# WEB_BILLING_PRODUCT_ID=com.slpcommand.pro.monthly

# REQUIRED (with WEB_BILLING_PRODUCT_ID). SERVER-ONLY — never expose publicly:
# it is the base of the hosted checkout link (the App User ID is appended
# per-request server-side; the base URL itself is not a secret RevenueCat
# protects, but there is no reason for it to be reachable except through the
# authenticated route that builds the full link).
# WEB_BILLING_PURCHASE_URL=https://pay.rev.cat/xxxxx/slpcommand

# OPTIONAL. SERVER-ONLY. Absent -> the checkout itself states the price,
# and /subscription says so honestly rather than guessing a number.
# WEB_BILLING_DISPLAY_PRICE=€9.99

# OPTIONAL, and only rendered when WEB_BILLING_DISPLAY_PRICE is also set
# (a period with no price is meaningless on its own).
# WEB_BILLING_PERIOD=month

# OPTIONAL. SERVER-ONLY. Defaults to "SLP Command Pro" if unset.
# WEB_BILLING_PLAN_NAME=SLP Command Pro
